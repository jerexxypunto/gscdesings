mixin classCard(card)
    - let wsp_message = "Hola, me interesa tu servicio de desarrollo web. ¿Podrías darme más información?"
    - if (!card.quoteUrl) {
        - card.quoteUrl = `https://wa.me/56990055107?text=${encodeURIComponent(wsp_message)}`   
        
    .class-card.col-6.col-md-12
        .front
            a.btn-green.btn(href=card.quoteUrl)
                img(src="./assets/white-icon-wp.png", alt="Whatsapp" class="img-fluid button-icon")
                p Cotizar
            a.btn-white-ghost.btn(href=card.detailsUrl)
                img(src="./assets/white-icon-bulb.png", alt="Bulb" class="img-fluid button-icon")
                p Ver más

        .background
            img(src=card.backgroundImage, alt=card.backgroundAlt class="img-fluid img-card")
