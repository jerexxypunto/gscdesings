extends layout/page.pug

include mixins/class-card.pug

block content
    .bg-white
        .container
            section.section-container.container-grid.h-60vh.mb-4
                div.col-6.align-content-center
                    h2.font-display-2 Desarrollo de 
                        span.bold Sitios Web
                    p Transforma tu presencia en línea con diseños web cautivadores y funcionales. Destaca entre la multitud con una página web que refleje la esencia única de tu marca.
                picture.col-6.align-content-center
                    img(src="./assets/dev-home.png", alt="Banner" class="img-fluid img-banner")
    .bg-green-wave
        .container
            section.section-container.container-grid.pb-5.mb-5
                picture.col-6.align-content-center.position-relative.position-negative-top-10
                    img(src="./assets/home.png", alt="App" class="img-fluid img-app")
                div.col-6.align-content-center
                    h2.font-display-3 Hola!!
                    h3.font-display-2 Soy 
                        span.bold Jeremías San Martín
                    p.mt-1 Desde mi adolecencia, me he sumergido en el apasionante mundo del desarrollo de software. Me especializo en el desarrollo y diseño de sitios web, así como en la creación de aplicaciones web. Disfruto combinando creatividad y tecnología para crear experiencias en línea sorprendentes. Con una profunda pasión por mi trabajo, estoy siempre listo para colaborar, siendo responsable y comprometido con cada proyecto que emprendo.
                    h4.mt-2.font-display-1 ¡Es un placer conocerte y espero poder ayudarte a llevar tus ideas al siguiente nivel!
                    a.btn-white.mt-1(href="#") Conversemos

    .bg-white
        .container
            h2.font-display-2.text-align-center Clases de Wordpress <span class="badge-green" > <img src="./assets/live-badge.png" alt="En Vivo">  En Vivo </span>
            .container-grid.mt-3 
                +classCard({
                    backgroundImage: "./assets/clases-card-dev.png",
                    backgroundAlt: "Clase para desarrolladores",
                    quoteUrl: "#",
                    detailsUrl: "#",
                })

                +classCard({               
                    backgroundImage: "./assets/clases-card-contenido.png",
                    backgroundAlt: "Creadores de contenido",
                    quoteUrl: "#",
                    detailsUrl: "#"
                })

                .banner-info.col-12.bg-dark-green.mb-2
                    img(src="./assets/Bombillo-Green.png", alt="Badge" class="img-fluid")
                    div
                        <h3 class="text-align-right" >SI CONVECES A ALGUN AMIGO DE <b>TOMAR</b> LA CLASE <b>CONTIGO</b> </h3>
                        <h3 class="text-align-right" >OBTEN TU CLASE A <b>$10.000</b>.</h3>

        .banner-soy-yo
            .container
                .container-grid
                    picture.col-4
                        img(src="./assets/wordpress.jpg", alt="Badge" class="img-fluid")
                    .col-8.banner-soy-yo__info
                            <h3 class="text-align-left" >Desarrollo especializado <br/> <span class="marked"> en WordPress </span> </h3>
                            p.text-align-left ¿Tienes un proyecto en mente y no encuentras un theme o plugin de Wordpress que haga exactamente lo que necesitas?
                            h4.text-align-left Desarrollemos juntos la solución que necesitas!
                            <button class="btn-white mt-1"> <img src="./assets/green-icon-wp.png" alt="WhatsApp" class="img-fluid button-icon"/> Cotizar </button>

            
                