extends layout/page.pug
include mixins/SalesCard.pug
include mixins/ClassItem.pug

block content
    .container#home 
        .row 
            .col-md-8.col-sm-12.titles-wrapper 
                .titles 
                    h2 Páginas web que hablan por ti
                    p En GSC Diseños creamos sitios web con WordPress que cargan rápido y se ven bien en cualquier pantalla. Jeremías San Martín lleva más de seis años construyendo páginas para negocios que necesitan vender más y complicarse menos.
                    .button-row
                        button.btn.btn-green Contáctanos 
                        button.btn.btn-ghost Servicios

            picture.col-md-4.col-sm-12 
                img(src="./assets/home.png", alt="" class="img-fluid")
    .container-fluid.bg-whitegren#sales 
        .container
            .row 
                .col-12 
                    h4.text-center Diseño 
                    h2.text-center Páginas web que venden
                    p.text-center En GSC Diseños creamos sitios web profesionales con WordPress, personalizados para cada negocio. Nos enfocamos en resultados concretos, como aumentar las ventas y simplificar la gestión.

                    .button-row
                        button.btn.btn-ghost Contáctanos 
                        button.btn.btn-transparent.btn-more Ver más

                .col-12.mt-4 
                    ul.sales-list
                        li(class="active" data-id="1") Perzonalización 
                        li(data-id="2") Resultados 
                        li(data-id="3") Soporte

                    .sales-card-wrapper

                        +SalesCard(
                            "Diseño",
                            "Diseño a medida para tu marca",
                            "Cada página web se adapta a la identidad de tu negocio. Trabajamos con tus colores, tipografías y estilo para reflejar quién eres.",
                            "Contáctanos",
                            "Ver más",
                            "./assets/SalesCard-1.png",
                            "SalesCard-1.png",
                            "1"
                        )

                        +SalesCard(
                            "Resultados",
                            "Enfoque en resultados concretos",
                            "Diseñamos pensando en tus objetivos, como generar más clientes o facilitar las compras. Medimos el éxito por el impacto en tu negocio.",
                            "Contáctanos",
                            "Ver más",
                            "./assets/SalesCard-2.png",
                            "SalesCard-2.png",
                            "2"
                        )

                        +SalesCard(
                            "Soporte",
                            "Soporte continuo para tu tranquilidad",
                            "Ofrecemos mantenimiento y actualizaciones para que tu sitio funcione sin problemas. Estamos disponibles para resolver cualquier duda.",
                            "Contáctanos",
                            "Ver más",
                            "./assets/SalesCard-3.png",
                            "SalesCard-3.png",
                            "3"
                        )
    .container.class#class-dev 
        .row 
            .col-12
                h4.text-center Clases
                <h2 class="class-titles text-center" > <big class="text-blue" > WordPress </big> para programadores </h2>
                p.text-center Aprende a desarrollar sitios web personalizados con WordPress, dominando temas, plugins y código. Enfocado en programadores que buscan ampliar sus habilidades técnicas.

                .button-wrapper
                    button.btn.btn-dark-ghost  Contáctanos 
                    button.btn.btn-transparent.btn-more Ver más           

            +ClassItem(
                "./assets/Brush.png", 
                "Diseño", 
                "Themes"
            )  

            +ClassItem(
                "./assets/Plugin.png", 
                "Plugin", 
                "Plugins"
            )  

            +ClassItem(
                "./assets/Code.png", 
                "Code", 
                "Code"
            )  

    .container-fluid.bg-whitegren.class#class-creator
        .container
            .row 
                .col-12 
                    h4.text-center Clases 
                    <h2 class="class-titles text-center" > <big class="text-blue" > WordPress </big> para creadores de contenido </h2>
                    .button-wrapper.mb-5
                        button.btn.btn-dark-ghost Incríbete 
                        button.btn.btn-transparent.btn-more Ver más 
                
                .col-md-6.col-sm-12
                    .class-info-block
                        h3 Diseño visual atractivo
                        p Domina el editor de bloques y las plantillas para crear páginas que capturen la atención. Aprenderás a seleccionar tipografías, colores e imágenes que refuercen tu marca.
                        hr
                    .class-info-block
                        h3 Gestión de contenido sencilla
                        p Organiza tus entradas, páginas y medios con facilidad. Te mostramos cómo programar publicaciones y mantener tu sitio actualizado sin complicaciones.
                        hr
                    .class-info-block
                        h3 Sin necesidad de programar
                        p Olvídate del código. Con WordPress y los plugins adecuados, podrás añadir funcionalidades y personalizar tu sitio arrastrando y soltando elementos.
                        hr

                .col-md-6.col-sm-12
                    img(src="./assets/Jere WP.png", alt="class-creator" class="img-fluid")

            
    .container#about-me
        .row 
            .col-md-6.col-sm-12
                picture
                    img(src="./assets/webicon.png", alt="WordPress" class="img-fluid")
                h2 Conoce a Jeremías San Martín
                p Jeremías San Martín es la mente detrás de cada proyecto en GSC Diseños. Con más de seis años en el mercado, ha construido páginas web que funcionan y venden.

                .button-wrapper
                    button.btn.btn-dark-ghost Contáctanos 
                    button.btn.btn-transparent.btn-more Ver más

            .col-md-6.col-sm-12.mt-3
                picture
                    img(src="./assets/Jere-Profile.png", alt="Jeremías San Martín" class="img-fluid")