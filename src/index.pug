extends layout/page.pug
include mixins/SalesCard.pug
include mixins/ClassItem.pug

block content
    .container#home 
        .row 
            .col-md-8.col-sm-12.titles-wrapper 
                .titles 
                    h2 Páginas web que hablan por ti
                    p En GSC Diseños creamos sitios web con WordPress que cargan rápido y se ven bien en cualquier pantalla. Jeremías San Martín lleva más de seis años construyendo páginas para negocios que necesitan vender más y complicarse menos.
                    .button-row
                        button.btn.btn-green Contáctanos 
                        button.btn.btn-ghost Servicios

            picture.col-md-4.col-sm-12 
                img(src="./assets/home.png", alt="" class="img-fluid")
    .container-fluid.bg-whitegren#sales 
        .container
            .row 
                .col-12 
                    h4.text-center Diseño 
                    h2.text-center Páginas web que venden
                    p.text-center En GSC Diseños creamos sitios web profesionales con WordPress, personalizados para cada negocio. Nos enfocamos en resultados concretos, como aumentar las ventas y simplificar la gestión.

                    .button-row
                        button.btn.btn-ghost Contáctanos 
                        button.btn.btn-transparent Ver más

                .col-12.mt-4 
                    ul.sales-list
                        li.active Perzonalización 
                        li Resultados 
                        li Soporte

                    .sales-card-wrapper     
                        +SalesCard(
                            "Diseño",
                            "Diseño a medida para tu marca",
                            "Cada página web se adapta a la identidad de tu negocio. Trabajamos con tus colores, tipografías y estilo para reflejar quién eres.",
                            "Contáctanos",
                            "Ver más",
                            "./assets/SalesCard-1.png",
                            "SalesCard-1.png"
                        )
    .container#class 
        .row 
            .col-12
                h4 Clases
                <h2 class="class-titles" > <big class="text-blue" > WordPress </big> para programadores </h2>
                p Aprende a desarrollar sitios web personalizados con WordPress, dominando temas, plugins y código. Enfocado en programadores que buscan ampliar sus habilidades técnicas.

                .button-wrapper
                    button.btn.btn-ghost Contáctanos 
                    button.btn.btn-transparent Ver más           

            +ClassItem(
                "./assets/Brush.png", 
                "Diseño", 
                "Themes"
            )  

            +ClassItem(
                "./assets/Plugin.png", 
                "Plugin", 
                "Plugins"
            )  

            +ClassItem(
                "./assets/Code.png", 
                "Code", 
                "Code"
            )  